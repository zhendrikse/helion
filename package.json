{
  "name": "helion",
  "version": "1.0.0",
  "type": "module",
  "description": "A web-based simulation environment for educational and scientific visualizations",
  "main": "./dist/helion.umd.js",
  "module": "./dist/helion.es.js",
  "exports": {
    ".": {
      "import": "./dist/helion.es.js",
      "require": "./dist/helion.umd.js"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "prebuild": "vitest run",
    "build": "npm run build:all",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:examples": "vite build --config vite.examples.config.js",
    "build:all": "npm test && npm run build:lib && npm run build:examples",
    "docs:build": "cd docs && npm install && npm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhendrikse/helion.git"
  },
  "keywords": [
    "physics",
    "mathematics",
    "simulation"
  ],
  "author": "Zeger Hendrikse",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhendrikse/helion/issues"
  },
  "homepage": "https://github.com/zhendrikse/helion#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "katex": "^0.18.9",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.0",
    "uplot": "^1.6.32"
  },
  "peerDependencies": {
    "three": "^0.186.0",
    "uplot": "^1.6.32"
  }
}
